        </mxCell>
        <mxCell id="p2_sec_label" value="Adicione controles de acordo com o modelo de ameaça, os dados e as permissões exigidas." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#9F1239;" vertex="1" parent="1">
          <mxGeometry x="75" y="475" width="660" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2_quality_label" value="Adicione quando busca, contexto ou qualidade de resposta precisarem de reforço." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="835" y="475" width="660" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2_ops_label" value="Adicione quando confiabilidade, custo, latência ou diagnóstico forem requisitos." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1595" y="475" width="650" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2_privacy" value="Atenção à memória: defina retenção, controle de acesso, minimização e remoção de dados sensíveis antes de gravar mensagens ou episódios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#92400E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
