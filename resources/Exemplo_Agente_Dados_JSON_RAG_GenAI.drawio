        <mxCell id="p2_sub" value="Estes componentes são extensões opcionais: acrescente-os quando houver um requisito que justifique custo e complexidade." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="42" y="65" width="2200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2_ingest_label" value="Documentos de origem → chunking → embeddings → banco vetorial" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2_json_note" value="O banco JSON é consultado em tempo de execução. Já os documentos de referência são pré-processados e indexados antes da consulta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
